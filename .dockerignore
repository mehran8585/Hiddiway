# =============================================================================
# .dockerignore
# =============================================================================
# هرچه اینجا باشد، هنگام `docker build` نادیده گرفته می‌شود (ارسال نشده به
# daemon داکر) → build سریع‌تر و ایمیج کوچک‌تر.
# =============================================================================

# فایل‌های گیت
.git
.gitignore
.github
.gitlab-ci.yml

# داکیومنت‌ها (نیازی به‌شان داخل ایمیج نیست)
*.md
docs/
LICENSE

# داده‌های لوکال
docker-data/
*.db
*.sqlite
*.log

# IDE / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# خود فایل‌های docker-compose و railway.json (نیاز داخل ایمیج نیست)
docker-compose.yml
railway.json

# CI / test
tests/
*.test.*