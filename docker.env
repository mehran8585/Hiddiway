# =============================================================================
# docker.env — متغیرهای محیطی Hiddify روی Railway
# =============================================================================
# این مقادیر را در پنل Railway → Variables به‌عنوان Environment Variables وارد
# کنید. مقادیر پیش‌فرض زیر فقط برای تست لوکال هستند؛ در پروداکشن حتماً
# پسوردهای قوی تصادفی بگذارید.
# -----------------------------------------------------------------------------

# --- MariaDB ---
MYSQL_PASSWORD=change-me-to-a-strong-random-password
MYSQL_DATABASE=hiddifypanel
MYSQL_USER=hiddifypanel

# --- Redis ---
REDIS_PASSWORD=change-me-to-a-strong-random-password

# --- Hiddify اتصال‌ها (توسط start.sh از متغیرهای بالا ساخته می‌شود) ---
# این دو را خود start.sh می‌سازد، اما اگر خواستید override کنید:
# SQLALCHEMY_DATABASE_URI=mysql+mysqldb://hiddifypanel:PASS@127.0.0.1:3306/hiddifypanel?charset=utf8mb4
# REDIS_URI_MAIN=redis://:PASS@127.0.0.1:6379/1

# --- پنل هیدیفای ---
# مسیر پایه‌ی پنل (باید با nginx هماهنگ باشد)
HIDDIFY_PANEL_BASE_PATH=/admin/
# حالت پکیج: release / beta / dev
HIDDIFY_PACKAGE_MODE=release

# --- Railway ---
# پورت عمومی Railway. خود Railway متغیر PORT را تزریق می‌کند،
# اینجا فقط پیش‌فرض برای تست لوکال است.
PORT=3000